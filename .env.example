# Optional OpenAI-compatible AI provider.
# Leave empty to use local TF-IDF and extractive-NLP fallbacks.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional database URL override. Default: data/research.db
# RESEARCH_DATABASE_URL=sqlite:///data/research.db

# Optional OpenAlex polite-pool contact address.
# OPENALEX_MAILTO=you@example.com

# PDF size limit in megabytes.
MAX_UPLOAD_MB=25